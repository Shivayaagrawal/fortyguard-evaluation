# Copy to .env and fill locally. Never commit .env or paste the key into chat, logs, or reports.

# Same FortyGuard API key. REST sends it as `api-key`. MCP sends it as `Authorization: Bearer`.
FORTYGUARD_API_KEY=

# Documented production API origin.
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com

# Documented remote MCP endpoint.
FORTYGUARD_MCP_URL=https://tos-mcp.app.fortyguard.com/mcp

# Dashboard sign-in. Do not store the dashboard password here.
FORTYGUARD_DASHBOARD_URL=https://dashboard.fortyguard.com/login

# Plan name once known: basic | startup | premium | unknown
FORTYGUARD_PLAN=unknown

# Remaining credits observed in the account before any paid call. Leave blank until checked.
FORTYGUARD_CREDITS_REMAINING=

# Paid calls stay refused until this is exactly "true".
FORTYGUARD_ALLOW_PAID=false

# Hard ceiling for this evaluation. The harness refuses a paid call that would cross it.
FORTYGUARD_CREDIT_BUDGET=10000
