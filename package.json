{
  "name": "fortyguard-evaluation",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed evaluation harness for the FortyGuard Temperature Dashboard, API, and MCP.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
